{
  "name": "projectiq",
  "private": true,
  "version": "0.1.0",
  "description": "ProjectIQ — AI project-intelligence system (portfolio MVP)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:verify": "node scripts/verify-schema.mjs",
    "seed": "npm run seed --workspace=backend",
    "setup:storage": "npm run setup:storage --workspace=backend",
    "test:rls": "npm run test:rls --workspace=backend"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=20"
  }
}
